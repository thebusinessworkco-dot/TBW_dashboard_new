# ==============================================================================
# THE BUSINESS WORK — ADMIN DASHBOARD ENVIRONMENT VARIABLES
# Production-ready configuration. Copy this file to .env.local
# DO NOT COMMIT SECRETS OR SERVICE ROLE KEYS TO VERSION CONTROL.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=https://dashboard.thebusinesswork.com

# 1. Supabase Backend & Authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional fallback alias for legacy configurations:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose

# 2. Strict Admin Authorization Check
ADMIN_AUTHORIZED_EMAIL=thebusinesswork.co@gmail.com

# 3. Official Meta / WhatsApp Cloud API
WHATSAPP_CLOUD_API_ACCESS_TOKEN=your-whatsapp-cloud-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

# 4. Official Instagram Graph API (Comment-to-DM & DMs)
INSTAGRAM_GRAPH_API_ACCESS_TOKEN=your-instagram-long-lived-page-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# 5. Self-Hosted n8n VPS Automation Endpoint
N8N_API_BASE_URL=https://n8n.thebusinesswork.com
N8N_API_KEY=your-n8n-api-key-from-n8n-settings-api

# 6. Google Sheets Integration (Master Spreadsheet)
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_SHEETS_CREDENTIALS_JSON=

# 7. VPS Monitoring Security
VPS_METRICS_BEARER_TOKEN=your-custom-secure-vps-monitoring-token
