      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n            function getCleanRows(nodeName) {\n              try {\n                const items = $(nodeName).all();\n                if (!items || items.length === 0) return [];\n                return items.map(i => i.json).filter(j => !j.error && Object.keys(j).length > 0 && !j.message?.includes('No item to return'));\n              } catch(e) {\n                return [];\n              }\n            }\n            return [{\n              json: {\n                leads: getCleanRows('Read Leads'),\n                whatsappLeads: getCleanRows('Read WhatsApp'),\n                appointments: getCleanRows('Read Appointments')\n              }\n            }];\n          "
      }
    }
